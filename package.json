{
  "name": "music-share",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @music-share/server",
    "dev:client": "npm run dev -w @music-share/client",
    "desktop": "node scripts/desktop.mjs",
    "build": "npm run build -w @music-share/server && npm run build -w @music-share/client",
    "test": "npm run build -w @music-share/server && vitest run",
    "test:rust": "cargo test --manifest-path apps/client/src-tauri/Cargo.toml --no-default-features",
    "typecheck": "npm run typecheck -w @music-share/server && npm run typecheck -w @music-share/client",
    "test:desktop-launcher": "node --test scripts/desktop.test.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "package:win:check": "node scripts/package-windows.mjs --check",
    "package:mac": "node scripts/package-unix.mjs mac",
    "package:mac:check": "node scripts/package-unix.mjs mac --check",
    "package:linux": "node scripts/package-unix.mjs linux",
    "package:linux:check": "node scripts/package-unix.mjs linux --check",
    "test:packaging": "node --test scripts/package-unix.test.mjs",
    "version:check": "node scripts/version.mjs --check",
    "version:sync": "node scripts/version.mjs --sync",
    "release:version": "node scripts/version.mjs",
    "release:notes": "node scripts/version.mjs --notes",
    "test:version": "node --test scripts/version.test.mjs",
    "test:ci-release": "node --test scripts/ci-release.test.mjs",
    "test:updater": "node --test scripts/updater-config.test.mjs"
  },
  "devDependencies": {
    "vitest": "^5.0.3",
    "typescript": "~5.9.3",
    "@types/node": "^22.18.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
