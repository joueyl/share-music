server {
    listen 443 ssl;
    server_name music.example.com;
    ssl_certificate /etc/letsencrypt/live/music.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/music.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    location = /api/music/upload {
        client_max_body_size 100m;
        proxy_read_timeout 150s;
        proxy_send_timeout 150s;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $http_host;
    }
    # Set NETEASE_ADMIN_TOKEN; set NETEASE_LOGIN_ORIGIN to the exact public origin for Docker/remote proxies.
    location /loginServe {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location ~ ^/api/rooms/[0-9a-f-]+/music/netease$ {
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $http_host;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $http_host;
    }
    # Web playback downloads a verified complete audio file through the authenticated API.
    location ~ ^/api/rooms/[0-9a-f-]+/music/[0-9a-f-]+/audio$ {
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_buffering off;
        proxy_cache off;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $http_host;
    }
    location /ws {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 30s;
    }
}
