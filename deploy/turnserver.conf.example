listening-port=3478
realm=music-share
fingerprint
use-auth-secret
# Must match apps/server/.env TURN_SECRET. Never commit the real configuration.
static-auth-secret=replace-with-a-different-long-random-secret
external-ip=YOUR_PUBLIC_IP
min-port=49160
max-port=49200
max-allocate-lifetime=60
user-quota=2
total-quota=24
no-tls
no-dtls
no-multicast-peers
no-loopback-peers
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
no-cli
log-file=stdout
simple-log
