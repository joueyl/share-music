PORT=3000
DATABASE_PATH=./data/music-share.sqlite
TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
TURN_SECRET=replace-with-a-different-long-random-secret
TURN_PUBLIC_HOST=your-server.example.com
# Comma-separated list; STUN_URL is still supported for a single legacy address.
STUN_URLS=stun:stun.miwifi.com:3478,stun:39.107.142.158:3478

# coturn (default), metered, or static
TURN_PROVIDER=coturn
# External relay capacity is independent of your own server's 5 Mbps egress.
PUBLIC_TURN_BUDGET_BPS=3500000
# Metered: hostname only; API key stays on the NestJS server.
METERED_DOMAIN=
METERED_API_KEY=
# Alternative provider static credentials (comma-separated UDP/TCP/TLS URLs).
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
