# 服务端配置模板：复制本文件为 apps/server/.env 后填写；不要提交真实 .env。
# 在项目根目录运行 npm run dev:server 或 npm run start -w @music-share/server 会自动加载该文件。
# 修改后完整重启服务；Docker env_file 修改后需要重新创建容器，不能仅 restart。

# ── 基础服务 ──────────────────────────────────────────────────────
# 本地开发用 development；正式部署改为 production（Compose 会强制覆盖为 production）。
NODE_ENV=development
PORT=3000
# 本机/同机 Nginx 使用 127.0.0.1；容器或需要远程直连时使用 0.0.0.0，并配置防火墙。
# deploy/compose.yml 会覆盖 BIND_ADDRESS=0.0.0.0。
BIND_ADDRESS=127.0.0.1
# 登录 IP 默认取直连地址；反向代理时仅填写可信代理 IP/CIDR（逗号分隔），不要信任整个公网。
# 同机 Nginx 示例：127.0.0.1/32,::1/128；代理必须正确覆盖/追加 X-Forwarded-For。
TRUST_PROXY=
# MySQL 8.0+；先创建数据库。用户名/密码特殊字符须 URL 编码，不要提交真实连接串。
DATABASE_DRIVER=mysql
DATABASE_URL=mysql://music_share:REPLACE_ME@localhost:3306/share-music
# 可选：远程数据库的 TLS CA 文件路径（验证证书，不支持跳过证书验证）。
# MYSQL_SSL_CA=/run/secrets/mysql-ca.pem
# 仅测试/离线兼容使用 DATABASE_DRIVER=sqlite + DATABASE_PATH；生产环境不允许 SQLite。
# 必须替换为独立随机密钥，建议至少 32 个随机字节。更换后原登录会话失效。
# 生成方式：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-at-least-32-random-characters
# HTTP CORS 与 WebSocket 共用：逗号分隔，不加空格、不带路径或末尾斜杠，不使用 *。
# 部署网页时追加实际前端 Origin，例如 https://music.example.com；保留需要使用的桌面端来源。
ALLOWED_ORIGINS=http://localhost:11420,http://127.0.0.1:11420,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

# 音乐只在数据库中保存直链、过期时间与元数据，不再需要对象存储配置。

# ── 网易云管理登录 /loginServe ────────────────────────────────────
# 远程或反向代理访问必填独立随机管理密码；浏览器认证用户名 admin，密码为该值。
# 留空仅允许受限制的本机直连管理，不代表任意访问免认证。公网管理必须使用 HTTPS。
NETEASE_ADMIN_TOKEN=
# 反向代理部署时填浏览器实际访问的 Origin，例如 https://music.example.com 或 https://music.example.com:8443。
# 不带 /loginServe、其他路径、查询参数或末尾斜杠；本机直接访问可留空。
NETEASE_LOGIN_ORIGIN=
# 网易云 Cookie 由管理登录后写入 DATABASE_URL 对应的 MySQL 数据库，不需要也不支持在本文件填写 Cookie。

# ── QQ 音乐 ─────────────────────────────────────────────────────
# QQ Music API 3.3.5 已作为服务端依赖；留空默认在服务端自动运行，无需另开端口。
# 可选：使用已有可信内网 HTTP 服务时填写地址；不要填写 Cookie/token。
QQ_MUSIC_API_URL=
# 内置 QQ 设备与加密会话的持久目录，默认工作目录/.qq-music；需可写并和数据库一起备份。
QQ_MUSIC_STATE_DIR=
