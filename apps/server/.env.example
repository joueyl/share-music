PORT=3000
DATABASE_PATH=./data/music-share.sqlite
TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:11420,http://127.0.0.1:11420,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
TURN_SECRET=replace-with-a-different-long-random-secret
TURN_PUBLIC_HOST=your-server.example.com
# Comma-separated list; STUN_URL is still supported for a single legacy address.
STUN_URLS=stun:stun.miwifi.com:3478,stun:39.107.142.158:3478

# coturn (default), metered, or static
TURN_PROVIDER=coturn
# External relay capacity is independent of your own server's 5 Mbps egress.
PUBLIC_TURN_BUDGET_BPS=3500000
# Metered: hostname only; API key stays on the NestJS server.
METERED_DOMAIN=
METERED_API_KEY=
# Alternative provider static credentials (comma-separated UDP/TCP/TLS URLs).
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=

# OSS endpoint: host only, e.g. oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=your-bucket-name
OSS_REGION=cn-hangzhou
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Optional: configure BOTH to use an OSS access point (endpoint host only).
OSS_ACCESS_POINT_ENDPOINT=
OSS_ACCESS_POINT_ALIAS=
# Optional STS token; ID/secret must be from the same temporary session.
OSS_SECURITY_TOKEN=

# Required to expose /loginServe remotely. Browser Basic Auth: user admin, password this value.
NETEASE_ADMIN_TOKEN=
# Exact public origin behind a proxy, e.g. https://music.example.com or https://music.example.com:8443
# No /loginServe path. Changing env_file in Docker requires container recreation.
NETEASE_LOGIN_ORIGIN=
