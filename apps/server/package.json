    "@nestjs/platform-ws": "^11.1.0",
    "@nestjs/websockets": "^11.1.0",
    "ali-oss": "^6.23.0",
    "express": "^5.2.1",
    "NeteaseCloudMusicApi": "^4.32.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
