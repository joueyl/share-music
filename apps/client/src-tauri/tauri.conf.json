{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "共鸣 Music Share",
  "version": "0.2.2",
  "identifier": "com.musicshare.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:11420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "共鸣 · Music Share",
        "width": 1320,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https://*.music.126.net https://*.music.163.com; connect-src ipc: http://ipc.localhost https: http: ws: wss:; media-src https: blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "createUpdaterArtifacts": false,
    "active": false,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/joueyl/share-music/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
